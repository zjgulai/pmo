# 生产环境变量模板
# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，绝不进仓库。
#
#   cp .env.example .env && chmod 600 .env

# Postgres 密码。用于 db 容器与应用连接串。
# 生成：openssl rand -base64 24
POSTGRES_PASSWORD=

# PMO 后台口令。上线前必须改掉默认值 pmo。
# 建议：12 位以上，含大小写与符号
OGSM_PMO_PASSWORD=

# 会话 cookie 签名密钥。泄露等于任何人都能伪造登录态。
# 生成：openssl rand -hex 32
SECRET_KEY=

# 镜像 tag，默认 local。发布时用日期或 commit 短哈希便于回滚
IMAGE_TAG=local
